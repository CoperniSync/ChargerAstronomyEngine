{
  "metadata": [
    {
      "src": [
        {
          "src": "../../",
          "files": [
            "ChargerAstronomyEngine/ChargerAstronomyEngine/*.csproj",
            "ChargerAstronomyShared/src/ChargerAstronomyShared/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "nested",
	  "outputFormat": "markdown",
	  "filter": "filterConfig.yml"
    },
    {
      "src": [
        {
          "src": "../../",
          "files": [
            "Stargazer/Assembly-CSharp.csproj"
          ]
        }
      ],
      "dest": "stargazer",
      "namespaceLayout": "nested",
	  "outputFormat": "markdown",
	  "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
	  "default",
      "modern",
      "templates/stargazer"
    ],
    "globalMetadata": {
      "_appName": "Stargazer Data API",
      "_appTitle": "Stargazer Data API",
      "_appLogoPath": "images/copernisync_logo_small.svg",
      "_appFaviconPath": "images/copernisync_planet_only.svg",
      "_disableContribution": false,
      "_enableSearch": true,
      "pdf": false
    }
  }
}
